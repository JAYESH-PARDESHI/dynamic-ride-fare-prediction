# Copy this file to ".env" and edit. Never commit .env.

APP_ENV=development            # development | production
LOG_LEVEL=INFO

# ---- ML model (path relative to the backend root, or absolute) ----
MODEL_PATH=models/fare_prediction_pipeline.pkl

# ---- Routing: osrm (no key needed) | openrouteservice (needs ROUTING_API_KEY) ----
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
# ROUTING_BASE_URL=            # optional, e.g. your own OSRM server

# ---- Weather: openmeteo (no key needed) | openweathermap (needs WEATHER_API_KEY) ----
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=
# WEATHER_BASE_URL=            # optional override
WEATHER_CACHE_SECONDS=600

HTTP_TIMEOUT_SECONDS=8

# ---- Geocoding: location search + reverse geocoding (Nominatim / OpenStreetMap, no key) ----
# The public Nominatim server requires an identifying User-Agent: put YOUR email or site here.
GEOCODER_CONTACT=
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org   # use your own Nominatim for real traffic
# GEOCODER_MIN_INTERVAL_SECONDS=1.0   # provider policy: max 1 request / second
# GEOCODER_MAX_QUEUE_SECONDS=4.0      # waiting longer than this -> HTTP 429
# GEOCODER_CACHE_SECONDS=86400
# GEOCODER_RESULT_LIMIT=8

# ---- Time sent to the ML model: utc (what it was trained on) | boston. See README section 10. ----
MODEL_CLOCK=utc

# ---- Which cab types get the simulated surge (others are sent with surge 1.0) ----
SURGE_CAB_TYPES=Uber,Lyft

# ---- CORS: comma-separated frontend origins. Avoid "*" in production. ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
